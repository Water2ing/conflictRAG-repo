\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Main results on the full 3,073-example evaluation set. Ans.\ F1 is computed only on examples where the gold action is \textsc  {Answer}; Halluc.\ \% is the FActScore-based hallucination rate on generated answers; Abst.\ P/R are abstention precision and recall treating non-\textsc  {Answer} as positive; Conf.\ Disc.\ F1 is conflict disclosure F1 on conflicting-evidence examples; Brier is calibration score on the 266-example held-out set. Best in each column is bolded; oracle (GPT-4 Verifier) is separated by a rule. $^{\dagger }$~Significantly better than all non-oracle baselines (bootstrap test, $p{<}0.05$, $n{=}1000$ samples).}}{6}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:main}{{1}{6}{Main results on the full 3,073-example evaluation set. Ans.\ F1 is computed only on examples where the gold action is \textsc {Answer}; Halluc.\ \% is the FActScore-based hallucination rate on generated answers; Abst.\ P/R are abstention precision and recall treating non-\textsc {Answer} as positive; Conf.\ Disc.\ F1 is conflict disclosure F1 on conflicting-evidence examples; Brier is calibration score on the 266-example held-out set. Best in each column is bolded; oracle (GPT-4 Verifier) is separated by a rule. $^{\dagger }$~Significantly better than all non-oracle baselines (bootstrap test, $p{<}0.05$, $n{=}1000$ samples)}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Dataset statistics and evaluation roles. Items counts reflect final evaluation partitions after deduplication and format filtering. The dev set is used exclusively for logistic policy layer training and threshold selection; all reported metrics are on the held-out test splits.}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:dataset-matrix}{{2}{6}{Dataset statistics and evaluation roles. Items counts reflect final evaluation partitions after deduplication and format filtering. The dev set is used exclusively for logistic policy layer training and threshold selection; all reported metrics are on the held-out test splits}{table.caption.9}{}}

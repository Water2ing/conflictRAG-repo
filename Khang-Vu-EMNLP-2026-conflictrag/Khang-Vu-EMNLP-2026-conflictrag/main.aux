\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Reliability diagram for ConflictRAG{}'s posterior probability of the \textsc  {Answer} action vs.\ empirical accuracy across five equal-frequency bins. The dashed line indicates perfect calibration. ConflictRAG{} is slightly overconfident in the 0.6--0.8 range (Brier score 0.214), performing substantially better than No-filter RAG (Brier 0.341) and comparably to the GPT-4 Verifier (Brier 0.198).}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:calibration}{{5}{8}{Reliability diagram for \method {}'s posterior probability of the \textsc {Answer} action vs.\ empirical accuracy across five equal-frequency bins. The dashed line indicates perfect calibration. \method {} is slightly overconfident in the 0.6--0.8 range (Brier score 0.214), performing substantially better than No-filter RAG (Brier 0.341) and comparably to the GPT-4 Verifier (Brier 0.198)}{figure.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Ablation study results. Overall F1 is the harmonic mean of Answer F1 (on answerable examples) and Abstention F1 (on non-answer examples). Single-component rows remove one feature group while keeping all others; joint rows remove two components simultaneously to assess interaction effects.}}{8}{table.caption.21}\protected@file@percent }

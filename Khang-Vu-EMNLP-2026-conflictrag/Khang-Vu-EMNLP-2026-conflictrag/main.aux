\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Performance--efficiency trade-off: overall F1 vs.\ inference latency per item for all evaluated systems. ConflictRAG{} (top-left) achieves the best F1 at the lowest latency, dominating all non-oracle systems on the Pareto frontier. GPT-4 Verifier is the only system with higher F1 (oracle), but at 1.7$\times $ the latency and significant API cost.}}{9}{figure.caption.26}\protected@file@percent }
\newlabel{fig:tradeoff-scatter}{{7}{9}{Performance--efficiency trade-off: overall F1 vs.\ inference latency per item for all evaluated systems. \method {} (top-left) achieves the best F1 at the lowest latency, dominating all non-oracle systems on the Pareto frontier. GPT-4 Verifier is the only system with higher F1 (oracle), but at 1.7$\times $ the latency and significant API cost}{figure.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Computational efficiency comparison. ConflictRAG{} achieves the highest throughput and lowest memory footprint. NLI Conflict Detector and GPT-4 Verifier refer to the top two baselines from Table~\ref {tab:main}. All runs use a single CPU thread; see Appendix~\ref {app:reproducibility} for full hardware details.}}{9}{table.caption.30}\protected@file@percent }
\newlabel{tab:efficiency}{{8}{9}{Computational efficiency comparison. \method {} achieves the highest throughput and lowest memory footprint. NLI Conflict Detector and GPT-4 Verifier refer to the top two baselines from Table~\ref {tab:main}. All runs use a single CPU thread; see Appendix~\ref {app:reproducibility} for full hardware details}{table.caption.30}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Ablation study: overall F1 (harmonic mean of Answer F1 and Abstention F1) for the full ConflictRAG{} system and variants with individual components removed. Removing the dispersion score causes the largest drop (4.1 points), followed by the NLI contradiction feature (2.9 points). Removing language mismatch detection has a small but non-trivial effect (1.1 points).}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ablation}{{3}{7}{Ablation study: overall F1 (harmonic mean of Answer F1 and Abstention F1) for the full \method {} system and variants with individual components removed. Removing the dispersion score causes the largest drop (4.1 points), followed by the NLI contradiction feature (2.9 points). Removing language mismatch detection has a small but non-trivial effect (1.1 points)}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Robustness of ConflictRAG{} across evaluation conditions: in-distribution (WhoQA + ConflictQA), out-of-distribution (NoMIRACL), high-noise (ConflictQA hard split with near-identical passages), and low-evidence (single retrieved passage). ConflictRAG{} degrades gracefully, with the largest drop occurring in the low-evidence setting where dispersion signals are uninformative.}}{7}{figure.caption.18}\protected@file@percent }
\newlabel{fig:robustness}{{4}{7}{Robustness of \method {} across evaluation conditions: in-distribution (WhoQA + ConflictQA), out-of-distribution (NoMIRACL), high-noise (ConflictQA hard split with near-identical passages), and low-evidence (single retrieved passage). \method {} degrades gracefully, with the largest drop occurring in the low-evidence setting where dispersion signals are uninformative}{figure.caption.18}{}}

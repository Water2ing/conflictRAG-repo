\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Annotation-noise ablation. Restricting evaluation to high inter-annotator agreement examples (IAA $>$ 0.8) yields a 2.2-point F1 gain (bootstrap $p = 0.008$, marked $^{**}$), indicating that ConflictRAG{} performance is robust to annotation noise and does not rely on noisy labels to inflate scores.}}{9}{table.caption.34}\protected@file@percent }
\newlabel{tab:iaa-ablation}{{9}{9}{Annotation-noise ablation. Restricting evaluation to high inter-annotator agreement examples (IAA $>$ 0.8) yields a 2.2-point F1 gain (bootstrap $p = 0.008$, marked $^{**}$), indicating that \method {} performance is robust to annotation noise and does not rely on noisy labels to inflate scores}{table.caption.34}{}}
